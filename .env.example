# Gemini API key for the server-side Job Match feature.
GEMINI_API_KEY=

# Supabase project URL and publishable key.
# The publishable key is safe to expose; never put a service_role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=isi_kunci_service_role_kamu_di_sini

# Optional production website URL for absolute metadata and social previews.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Cloudflare Turnstile (anti-bot form kontak). Kosongkan keduanya untuk menonaktifkan.
# Buat widget di Cloudflare Dashboard → Turnstile. Untuk tes lokal bisa pakai kunci uji resmi:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Notifikasi email saat ada pesan kontak baru (opsional, via https://resend.com).
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
# Wajib domain terverifikasi di Resend; tanpa itu biarkan kosong (pakai onboarding@resend.dev).
# CONTACT_FROM_EMAIL=WYNNSEA <halo@domainkamu.com>

# Agen Blog: Vercel Cron memanggil /api/cron/blog-agent dengan header Authorization: Bearer <CRON_SECRET>.
# Isi dengan string acak panjang (mis. hasil `openssl rand -hex 32`) di env Vercel.
CRON_SECRET=
